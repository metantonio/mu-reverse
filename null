import subprocess
import sys

def run(cmd):
    p = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    print(f"--- {cmd} ---")
    print(p.stdout)
    if p.stderr: print(p.stderr, file=sys.stderr)
    print()

# wsctlcd.dll
run("strings -el 'C:\\Program Files (x86)\\Webzen\\Mu\\wsctlcd.dll' 2>/dev/null | head -200")
run("strings -eI 'C:\\Program Files (x86)\\Webzen\\Mu\\wsctlcd.dll' 2>/dev/null | grep -iE 'crypt|cipher|enc|decrypt|mod|key|xor|block|packet' | head -50")
